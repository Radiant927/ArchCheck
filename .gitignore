# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
*.egg-info/
dist/
build/

# Virtual environments
venv/
.venv/
env/

# Environment variables & secrets
.env
.env.local
.secrets.toml
.streamlit/secrets.toml
llm/local_config.json

# AI enrichment disk cache
data/.enrich_cache.json

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
Desktop.ini

# Generated output (runtime artifacts)
output/*
!output/.gitkeep

# Node / JS build artifacts (web viewers)
node_modules/
ifc-demo/dist/
web-ifc-viewer/
ifc-demo/
.snowpack/

# One-off probe / diagnostic scripts (not part of the platform)
scripts/_*.py

# Duplicate copy of BIM test IFCs (canonical set lives in bim/test-suites/)
presentation/**/test-suites/

# Large media
*.mp4

# Local run logs
.tmp_streamlit.log

# Jupyter
.ipynb_checkpoints/

# RAG knowledge base (downloaded standards/statutes — large, regenerable)
data/rag_kb/

# Local-only Claude Code settings (per-machine, not shared)
.claude/settings.local.json
**/.claude/

# Large top-level BIM test files (small samples under bim/samples/ are tracked)
bim/*.ifc
