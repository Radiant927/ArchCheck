[
    {
        "id": "STR-001",
        "name": "柱最小截面尺寸检查",
        "description": "框架柱截面最小边不应小于构造要求 300mm",
        "field": "section_min_m",
        "operator": ">=",
        "threshold": 0.3,
        "unit": "m",
        "condition_field": "element_type",
        "condition_operator": "==",
        "condition_threshold": "column",
        "severity": "Medium",
        "code_ref": "GB 50011",
        "message": "柱截面最小边 {value}m 小于构造要求 {threshold}m，需加大柱截面。"
    },
    {
        "id": "STR-002",
        "name": "梁截面最小高度检查",
        "description": "框架梁截面高度不应小于构造要求 300mm",
        "field": "depth_m",
        "operator": ">=",
        "threshold": 0.3,
        "dynamic_threshold": {
            "formula": "max(0.2, min({span_m}, 6)/20)",
            "query": "跨度 {span_m}m 的次梁，构造要求的最小截面高度",
            "fallback": 0.2,
            "context_fields": ["span_m"]
        },
        "unit": "m",
        "condition_field": "element_type",
        "condition_operator": "==",
        "condition_threshold": "beam",
        "severity": "Medium",
        "code_ref": "GB 50010",
        "message": "梁截面高度 {value}m 小于构造要求 {threshold}m，需加大梁高。"
    },
    {
        "id": "STR-003",
        "name": "楼板最小厚度检查",
        "description": "现浇钢筋混凝土板厚不应小于 100mm",
        "field": "thickness_m",
        "operator": ">=",
        "threshold": 0.1,
        "unit": "m",
        "condition_field": "element_type",
        "condition_operator": "==",
        "condition_threshold": "slab",
        "severity": "Low",
        "code_ref": "GB 50010",
        "message": "楼板厚度 {value}m 小于要求 {threshold}m，需增加板厚。"
    }
