[
  {
    "id": "CIVIL-001",
    "name": "疏散距离检查",
    "description": "走廊疏散距离不应超过规范限值",
    "field": "corridor_length_m",
    "operator": "<=",
    "threshold": 30,
    "unit": "m",
    "severity": "High",
    "code_ref": "GB 50016",
    "message": "走廊长度 {value}m 超过限值 {threshold}m，需增设避难走道或重新设计疏散路线。"
  },
  {
    "id": "CIVIL-003",
    "name": "安全出口数量检查",
    "description": "面积超过阈值的房间需设置足够数量的安全出口",
    "field": "exit_count",
    "operator": ">=",
    "threshold": 2,
    "condition_field": "room_area_sqm",
    "condition_operator": ">",
    "condition_threshold": 50,
    "severity": "Medium",
    "code_ref": "GB 50016",
    "message": "房间面积 {condition_value}m² 超过 {condition_threshold}m²，仅设 {value} 个出口，至少需要 {threshold} 个。"
  },
  {
    "id": "CIVIL-004",
    "name": "疏散门净宽检查",
    "description": "疏散门净宽应满足规范最小值",
    "field": "door_width_m",
    "operator": ">=",
    "threshold": 0.9,
    "unit": "m",
    "severity": "Low",
    "code_ref": "GB 55037",
    "message": "门净宽 {value}m 小于要求的 {threshold}m，需加宽疏散门。"
  },
  {
    "id": "CIVIL-005",
    "name": "大房间疏散出口数量检查",
    "description": "建筑面积超过 60m² 的房间应设不少于 2 个疏散出口",
    "field": "exit_count",
    "operator": ">=",
    "threshold": 2,
    "condition_field": "room_area_sqm",
    "condition_operator": ">",
    "condition_threshold": 60,
    "severity": "High",
    "code_ref": "GB 55037",
    "message": "{room_name} 面积 {condition_value}m² 超过 60m²，应设置不少于 2 个疏散出口（当前 {value} 个）。"
  },
  {
    "id": "CIVIL-006",
    "name": "疏散走道/楼梯间应急照明检查",
    "description": "疏散走道与楼梯间应设置应急照明",
