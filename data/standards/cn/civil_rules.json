    "operator": "==",
    "threshold": true,
    "severity": "High",
    "condition_field": "type",
    "condition_operator": "in",
    "condition_threshold": ["Stairwell", "Corridor"],
    "code_ref": "GB 51309",
    "message": "{room_name} 位于疏散路径上，应配置应急照明。"
  },
  {
    "id": "CIVIL-007",
    "name": "房间疏散出口数量下限检查",
    "description": "每个房间至少设置一个疏散出口",
    "field": "exit_count",
    "operator": ">=",
    "threshold": 1,
    "condition_field": "room_area_sqm",
    "condition_operator": ">",
    "condition_threshold": 0,
    "severity": "High",
    "code_ref": "GB 55037",
    "message": "{room_name} 没有任何疏散出口，应至少设置 1 个疏散门。"
  },
  {
